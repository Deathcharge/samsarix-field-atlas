{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:samsarix:field-atlas:suite-report:1",
  "title": "Samsarix Field Atlas blueprint suite report v1",
  "description": "A deterministic local conformance report that binds readable blueprint artifacts by exact-byte SHA-256 without making runtime, identity, evidence, or release claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "suite",
    "policy",
    "source",
    "summary",
    "cases",
    "proofBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "samsarix-field-atlas/suite-report/1"
    },
    "mode": {
      "const": "contract-conformance-report"
    },
    "suite": {
      "$ref": "#/$defs/suiteMetadata"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strict"],
      "properties": {
        "strict": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {
        "manifest": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "uri",
                "sha256",
                "status",
                "validationStatus",
                "counts",
                "findings"
              ],
              "properties": {
                "uri": { "type": "string", "minLength": 1, "maxLength": 1024 },
                "sha256": { "$ref": "#/$defs/sha256" },
                "status": { "$ref": "#/$defs/status" },
                "validationStatus": { "$ref": "#/$defs/status" },
                "counts": { "$ref": "#/$defs/counts" },
                "findings": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/finding" }
                }
              }
            }
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cases", "findings"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "cases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "ready", "review", "invalid"],
          "properties": {
            "total": { "type": "integer", "minimum": 1, "maximum": 64 },
            "ready": { "type": "integer", "minimum": 0, "maximum": 64 },
            "review": { "type": "integer", "minimum": 0, "maximum": 64 },
            "invalid": { "type": "integer", "minimum": 0, "maximum": 64 }
          }
        },
        "findings": { "$ref": "#/$defs/counts" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/case" }
    },
    "proofBoundary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "$defs": {
    "status": {
      "enum": ["invalid", "review", "ready"]
    },
    "severity": {
      "enum": ["error", "warning", "pass"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "suiteMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "warning", "pass"],
      "properties": {
        "error": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "path", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "severity": { "$ref": "#/$defs/severity" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact",
        "tags",
        "status",
        "validationStatus",
        "scenario",
        "counts",
        "metrics",
        "findings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "sha256", "bytes"],
          "properties": {
            "uri": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "sha256": {
              "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
            },
            "bytes": {
              "anyOf": [
                { "type": "null" },
                { "type": "integer", "minimum": 0, "maximum": 1048576 }
              ]
            }
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "status": { "$ref": "#/$defs/status" },
        "validationStatus": { "$ref": "#/$defs/status" },
        "scenario": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "risk"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "title": { "type": "string", "minLength": 1, "maxLength": 240 },
                "risk": { "enum": ["low", "medium", "high"] }
              }
            }
          ]
        },
        "counts": { "$ref": "#/$defs/counts" },
        "metrics": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "roles",
                "stages",
                "humanGates",
                "evidenceArtifacts"
              ],
              "properties": {
                "roles": { "type": "integer", "minimum": 0, "maximum": 64 },
                "stages": { "type": "integer", "minimum": 0, "maximum": 128 },
                "humanGates": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 128
                },
                "evidenceArtifacts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 128
                }
              }
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    }
  }
}
