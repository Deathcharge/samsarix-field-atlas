{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:samsarix:field-atlas:suite-change-review:1",
  "title": "Samsarix Field Atlas declared suite change review v1",
  "description": "A deterministic evaluation of a bounded change plan against one exact suite comparison as of an explicitly supplied date.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "asOf",
    "source",
    "binding",
    "summary",
    "cases",
    "suite",
    "proofBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "samsarix-field-atlas/suite-change-review/1"
    },
    "mode": { "const": "declared-change-review" },
    "asOf": { "$ref": "#/$defs/date" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "comparison"],
      "properties": {
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "sha256", "owner", "reference", "expiresOn"],
          "properties": {
            "uri": { "$ref": "#/$defs/uri" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "owner": { "type": "string", "minLength": 2, "maxLength": 160 },
            "reference": {
              "type": "string",
              "minLength": 5,
              "maxLength": 1024
            },
            "expiresOn": { "$ref": "#/$defs/date" }
          }
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "candidate", "outcome", "gate", "failOn"],
          "properties": {
            "baseline": { "$ref": "#/$defs/reportSource" },
            "candidate": { "$ref": "#/$defs/reportSource" },
            "outcome": {
              "enum": ["regression", "review", "improvement", "unchanged"]
            },
            "gate": { "$ref": "#/$defs/gate" },
            "failOn": { "enum": ["regression", "change"] }
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteId", "baselineReportSha256"],
      "properties": {
        "suiteId": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected", "baseline", "candidate", "matched"],
          "properties": {
            "expected": { "$ref": "#/$defs/identifier" },
            "baseline": { "$ref": "#/$defs/identifier" },
            "candidate": { "$ref": "#/$defs/identifier" },
            "matched": { "type": "boolean" }
          }
        },
        "baselineReportSha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected", "actual", "matched"],
          "properties": {
            "expected": { "$ref": "#/$defs/sha256" },
            "actual": { "$ref": "#/$defs/sha256" },
            "matched": { "type": "boolean" }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "gate",
        "expired",
        "cases",
        "suiteSignalsMatched",
        "regressionAcknowledgements"
      ],
      "properties": {
        "status": { "enum": ["matched", "mismatch", "expired"] },
        "gate": { "$ref": "#/$defs/gate" },
        "expired": { "type": "boolean" },
        "cases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected",
            "actualChanges",
            "matched",
            "mismatched",
            "unexpected",
            "missing"
          ],
          "properties": {
            "expected": { "$ref": "#/$defs/count" },
            "actualChanges": { "$ref": "#/$defs/count" },
            "matched": { "$ref": "#/$defs/count" },
            "mismatched": { "$ref": "#/$defs/count" },
            "unexpected": { "$ref": "#/$defs/count" },
            "missing": { "$ref": "#/$defs/count" }
          }
        },
        "suiteSignalsMatched": { "type": "boolean" },
        "regressionAcknowledgements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "present"],
          "properties": {
            "required": { "$ref": "#/$defs/count" },
            "present": { "$ref": "#/$defs/count" }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/reviewCase" }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matched", "mismatches", "expected", "actual"],
      "properties": {
        "matched": { "type": "boolean" },
        "mismatches": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "reportImpact",
              "suiteMetadataChanged",
              "policyChanged",
              "manifestChanged"
            ]
          }
        },
        "expected": { "$ref": "#/$defs/signals" },
        "actual": { "$ref": "#/$defs/signals" }
      }
    },
    "proofBoundary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uri": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "gate": { "enum": ["pass", "fail"] },
    "count": { "type": "integer", "minimum": 0, "maximum": 128 },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "reportSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "$ref": "#/$defs/uri" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dimension": {
      "enum": [
        "artifact-uri",
        "artifact-content",
        "tags",
        "status",
        "validation-status",
        "scenario",
        "finding-counts",
        "findings",
        "metrics"
      ]
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "change",
        "impact",
        "dimensions",
        "regressionAcknowledged",
        "rationale"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/identifier" },
        "change": { "enum": ["added", "removed", "modified"] },
        "impact": {
          "enum": ["regression", "improvement", "review", "mixed"]
        },
        "dimensions": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "regressionAcknowledged": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 20, "maxLength": 1000 }
      },
      "allOf": [
        {
          "if": {
            "required": ["change"],
            "properties": { "change": { "const": "modified" } }
          },
          "then": {
            "properties": {
              "dimensions": { "type": "array", "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "dimensions": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["change"],
            "properties": { "change": { "const": "removed" } }
          },
          "then": {
            "properties": { "impact": { "const": "regression" } }
          }
        },
        {
          "if": {
            "required": ["change"],
            "properties": { "change": { "const": "added" } }
          },
          "then": {
            "properties": {
              "impact": { "enum": ["regression", "review"] }
            }
          }
        },
        {
          "if": {
            "required": ["impact"],
            "properties": {
              "impact": { "enum": ["regression", "mixed"] }
            }
          },
          "then": {
            "properties": {
              "regressionAcknowledged": { "const": true }
            }
          },
          "else": {
            "properties": {
              "regressionAcknowledged": { "const": false }
            }
          }
        }
      ]
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "impact", "dimensions"],
      "properties": {
        "change": { "enum": ["added", "removed", "modified"] },
        "impact": {
          "enum": ["regression", "improvement", "review", "mixed"]
        },
        "dimensions": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension" }
        }
      }
    },
    "reviewCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "disposition", "expected", "actual", "mismatches"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "disposition": {
          "enum": ["matched", "mismatched", "unexpected", "missing"]
        },
        "expected": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/expectation" }]
        },
        "actual": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/actual" }]
        },
        "mismatches": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "change",
              "impact",
              "dimensions",
              "regression-acknowledgement"
            ]
          }
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportImpact",
        "suiteMetadataChanged",
        "policyChanged",
        "manifestChanged"
      ],
      "properties": {
        "reportImpact": { "enum": ["regression", "improvement", "none"] },
        "suiteMetadataChanged": { "type": "boolean" },
        "policyChanged": { "type": "boolean" },
        "manifestChanged": { "type": "boolean" }
      }
    }
  }
}
