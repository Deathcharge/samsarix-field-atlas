{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:samsarix:field-atlas:suite-change-plan:1",
  "title": "Samsarix Field Atlas declared suite change plan v1",
  "description": "A bounded, expiring, owner-asserted declaration of exact expected suite drift. It records intent and does not authenticate approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "suiteId",
    "baselineSha256",
    "owner",
    "reference",
    "expiresOn",
    "rationale",
    "expectations",
    "suite",
    "proofBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "samsarix-field-atlas/suite-change-plan/1"
    },
    "mode": { "const": "declared-contract-change" },
    "suiteId": { "$ref": "#/$defs/identifier" },
    "baselineSha256": { "$ref": "#/$defs/sha256" },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "reference": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1024,
      "anyOf": [
        {
          "pattern": "^https://(?![^/]*@)[^/?#\\s]+(?:/[^?#\\s]*)?$"
        },
        {
          "pattern": "^urn:[a-z0-9][a-z0-9-]{0,31}:[a-zA-Z0-9][a-zA-Z0-9._:-]{0,511}$"
        }
      ]
    },
    "expiresOn": { "$ref": "#/$defs/date" },
    "rationale": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "expectations": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/expectation" }
    },
    "suite": { "$ref": "#/$defs/signals" },
    "proofBoundary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dimension": {
      "enum": [
        "artifact-uri",
        "artifact-content",
        "tags",
        "status",
        "validation-status",
        "scenario",
        "finding-counts",
        "findings",
        "metrics"
      ]
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "change",
        "impact",
        "dimensions",
        "regressionAcknowledged",
        "rationale"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/identifier" },
        "change": { "enum": ["added", "removed", "modified"] },
        "impact": {
          "enum": ["regression", "improvement", "review", "mixed"]
        },
        "dimensions": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "regressionAcknowledged": { "type": "boolean" },
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["change"],
            "properties": { "change": { "const": "modified" } }
          },
          "then": {
            "properties": {
              "dimensions": { "type": "array", "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "dimensions": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["change"],
            "properties": { "change": { "const": "removed" } }
          },
          "then": {
            "properties": { "impact": { "const": "regression" } }
          }
        },
        {
          "if": {
            "required": ["change"],
            "properties": { "change": { "const": "added" } }
          },
          "then": {
            "properties": {
              "impact": { "enum": ["regression", "review"] }
            }
          }
        },
        {
          "if": {
            "required": ["impact"],
            "properties": {
              "impact": { "enum": ["regression", "mixed"] }
            }
          },
          "then": {
            "properties": {
              "regressionAcknowledged": { "const": true }
            }
          },
          "else": {
            "properties": {
              "regressionAcknowledged": { "const": false }
            }
          }
        }
      ]
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportImpact",
        "suiteMetadataChanged",
        "policyChanged",
        "manifestChanged"
      ],
      "properties": {
        "reportImpact": {
          "enum": ["regression", "improvement", "none"]
        },
        "suiteMetadataChanged": { "type": "boolean" },
        "policyChanged": { "type": "boolean" },
        "manifestChanged": { "type": "boolean" }
      }
    }
  }
}
