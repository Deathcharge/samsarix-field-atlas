{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schema/a2a-tck-receipt.schema.json",
  "title": "Samsarix Field Atlas A2A TCK evidence receipt",
  "description": "A consumer-owned receipt that binds an official A2A TCK compatibility report to an acceptance plan without making a conformance or release claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "evidenceState",
    "claims",
    "source",
    "observations",
    "acceptanceCoverage",
    "reviewItems"
  ],
  "properties": {
    "schemaVersion": {
      "const": "samsarix-field-atlas/a2a-tck-receipt/1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "status": {
      "const": "owner-review-required"
    },
    "evidenceState": {
      "const": "attached-unreviewed"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolConformance", "releaseDecision"],
      "properties": {
        "protocolConformance": {
          "const": "not-determined"
        },
        "releaseDecision": {
          "const": "not-made"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptancePlan", "provenance", "tckReport"],
      "properties": {
        "acceptancePlan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "generatedAt",
            "scenarioId",
            "agentName",
            "agentVersion",
            "interfaceUrl",
            "binding",
            "protocolVersion",
            "acceptanceOwner",
            "environment"
          ],
          "properties": {
            "schemaVersion": {
              "const": "samsarix-field-atlas/a2a-acceptance/1"
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time",
              "maxLength": 64
            },
            "scenarioId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "agentName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "agentVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "interfaceUrl": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "binding": {
              "enum": ["JSONRPC", "GRPC", "HTTP+JSON"]
            },
            "protocolVersion": {
              "const": "1.0"
            },
            "acceptanceOwner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "environment": {
              "enum": ["local", "staging", "production"]
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceOwner",
            "tckRepository",
            "assertedTckRevision",
            "interpretedAgainstTckRevision",
            "implementationRevision",
            "runCommand"
          ],
          "properties": {
            "evidenceOwner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "tckRepository": {
              "const": "https://github.com/a2aproject/a2a-tck"
            },
            "assertedTckRevision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "interpretedAgainstTckRevision": {
              "const": "5996b79f9cefa6fc390980e383e358a66fb9e49e"
            },
            "implementationRevision": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "runCommand": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "tckReport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "timestamp",
            "sutUrl",
            "reportedSpecVersion",
            "embeddedAgentCard"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "maxLength": 64
            },
            "sutUrl": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "reportedSpecVersion": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ]
            },
            "embeddedAgentCard": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "requirements", "transports"],
      "properties": {
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["overall", "must", "should", "may"],
          "properties": {
            "overall": {
              "$ref": "#/$defs/percentage"
            },
            "must": {
              "$ref": "#/$defs/percentage"
            },
            "should": {
              "$ref": "#/$defs/percentage"
            },
            "may": {
              "$ref": "#/$defs/percentage"
            }
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "passed",
            "failed",
            "skipped",
            "notTested",
            "requirementsWithErrors",
            "errorMessages"
          ],
          "properties": {
            "total": {
              "$ref": "#/$defs/count"
            },
            "passed": {
              "$ref": "#/$defs/count"
            },
            "failed": {
              "$ref": "#/$defs/count"
            },
            "skipped": {
              "$ref": "#/$defs/count"
            },
            "notTested": {
              "$ref": "#/$defs/count"
            },
            "requirementsWithErrors": {
              "$ref": "#/$defs/count"
            },
            "errorMessages": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "transports": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "total", "passed", "failed", "skipped"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "total": {
                "$ref": "#/$defs/count"
              },
              "passed": {
                "$ref": "#/$defs/count"
              },
              "failed": {
                "$ref": "#/$defs/count"
              },
              "skipped": {
                "$ref": "#/$defs/count"
              }
            }
          }
        }
      }
    },
    "acceptanceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceAttachedCaseIds",
        "unresolvedCaseIds",
        "unresolvedBlockingCaseIds"
      ],
      "properties": {
        "evidenceAttachedCaseIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "const": "a2a-official-tck"
            }
          ],
          "items": false
        },
        "unresolvedCaseIds": {
          "$ref": "#/$defs/caseIds"
        },
        "unresolvedBlockingCaseIds": {
          "$ref": "#/$defs/caseIds"
        }
      }
    },
    "reviewItems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  },
  "$defs": {
    "percentage": {
      "type": "string",
      "pattern": "^(?:100\\.0|[0-9]{1,2}\\.[0-9])%$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "caseIds": {
      "type": "array",
      "maxItems": 499,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  }
}
