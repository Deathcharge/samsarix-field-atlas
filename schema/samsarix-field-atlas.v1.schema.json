{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:samsarix:field-atlas:1",
  "title": "Samsarix Field Atlas v1 blueprint",
  "description": "A provider-neutral, illustrative coordination contract. Additive fields are permitted for forward-compatible metadata and reported as warnings by the reference validator.",
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "generatedAt",
    "scenario",
    "indicators",
    "agents",
    "trace",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {
      "const": "samsarix-field-atlas/1"
    },
    "mode": {
      "const": "illustrative-reference"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "indicators": {
      "$ref": "#/$defs/indicatorComparison"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "trace": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/traceStep"
      }
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "title", "risk", "objective", "successCriteria"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "risk": {
          "enum": ["low", "medium", "high"]
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "indicators": {
      "type": "object",
      "required": ["harmony", "resilience", "prana", "drishti", "klesha"],
      "properties": {
        "harmony": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "resilience": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "prana": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "drishti": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "klesha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "indicatorComparison": {
      "type": "object",
      "required": ["note", "baseline", "outcome"],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "baseline": {
          "$ref": "#/$defs/indicators"
        },
        "outcome": {
          "$ref": "#/$defs/indicators"
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["id", "name", "layer", "role", "responsibility"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "layer": {
          "enum": ["consciousness", "operational", "integration"]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "responsibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "traceStep": {
      "type": "object",
      "required": [
        "order",
        "agentId",
        "title",
        "action",
        "boundary",
        "evidence"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "boundary": {
          "type": ["string", "null"],
          "enum": ["human", "policy", "tool", "memory", null]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "executesAgents",
        "callsExternalServices",
        "storesRemoteData",
        "requiresHumanApprovalAt"
      ],
      "properties": {
        "executesAgents": {
          "const": false
        },
        "callsExternalServices": {
          "const": false
        },
        "storesRemoteData": {
          "const": false
        },
        "requiresHumanApprovalAt": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
