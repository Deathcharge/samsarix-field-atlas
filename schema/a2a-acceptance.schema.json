{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schema/a2a-acceptance.v1.schema.json",
  "title": "Samsarix Field Atlas A2A acceptance plan v1",
  "description": "A consumer-owned, not-yet-run acceptance plan for a Field Atlas A2A implementation handoff. This is not an A2A extension, TCK report, or conformance result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "source",
    "acceptance",
    "summary",
    "testCases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "samsarix-field-atlas/a2a-acceptance/1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 64
    },
    "status": {
      "const": "plan-not-run"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/testCase"
      }
    }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint", "agentCard"],
      "properties": {
        "blueprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "scenarioId", "title", "risk"],
          "properties": {
            "schemaVersion": {
              "const": "samsarix-field-atlas/1"
            },
            "scenarioId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "maxLength": 128
            },
            "title": {
              "$ref": "#/$defs/boundedString"
            },
            "risk": {
              "enum": ["low", "medium", "high"]
            }
          }
        },
        "agentCard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "interfaceUrl",
            "binding",
            "protocolVersion",
            "inputModes",
            "outputModes",
            "authentication"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/boundedString"
            },
            "version": {
              "$ref": "#/$defs/boundedString"
            },
            "interfaceUrl": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "binding": {
              "enum": ["HTTP+JSON", "JSONRPC", "GRPC"]
            },
            "protocolVersion": {
              "const": "1.0"
            },
            "inputModes": {
              "$ref": "#/$defs/stringList"
            },
            "outputModes": {
              "$ref": "#/$defs/stringList"
            },
            "authentication": {
              "enum": ["bearer", "public"]
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "supportContact",
        "environment",
        "maxRequestBytes",
        "responseDeadlineMs",
        "maxConcurrentTasks",
        "retentionMode",
        "retentionHours",
        "dataClassification",
        "externalProcessors"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "supportContact": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320
        },
        "environment": {
          "enum": ["local", "staging", "production"]
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "responseDeadlineMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "maxConcurrentTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "retentionMode": {
          "enum": ["none", "transient", "retained"]
        },
        "retentionHours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8760
        },
        "dataClassification": {
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "externalProcessors": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testCases",
        "blockingCases",
        "officialTckCases",
        "humanApprovalCases",
        "evidenceCases"
      ],
      "properties": {
        "testCases": {
          "type": "integer",
          "minimum": 1
        },
        "blockingCases": {
          "type": "integer",
          "minimum": 1
        },
        "officialTckCases": {
          "const": 1
        },
        "humanApprovalCases": {
          "type": "integer",
          "minimum": 0
        },
        "evidenceCases": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/boundedString"
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "title",
        "blocking",
        "source",
        "requirement",
        "procedure",
        "expected",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 128
        },
        "category": {
          "enum": [
            "discovery",
            "security",
            "compatibility",
            "reliability",
            "governance",
            "evidence",
            "privacy"
          ]
        },
        "title": {
          "$ref": "#/$defs/boundedString"
        },
        "blocking": {
          "type": "boolean"
        },
        "source": {
          "enum": ["a2a-1.0", "field-atlas", "owner-profile"]
        },
        "requirement": {
          "$ref": "#/$defs/boundedString"
        },
        "procedure": {
          "$ref": "#/$defs/stringList"
        },
        "expected": {
          "$ref": "#/$defs/boundedString"
        },
        "evidence": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
